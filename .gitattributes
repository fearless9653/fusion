# Normalize text; default LF for the repo (cross-platform web sources)
* text=auto eol=lf

# Windows scripts keep CRLF when checked out on Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell / PowerShell / web sources — LF
*.sh text eol=lf
*.ps1 text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
