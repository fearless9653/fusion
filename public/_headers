# Cache rules for static assets (Workers Assets / Pages).
# Vite copies public/ → dist. SPA fallback is wrangler not_found_handling;
# this file only sets Cache-Control.
# https://developers.cloudflare.com/workers/static-assets/headers/

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/workbox-*.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
